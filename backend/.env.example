# Copy to .env for local development. Never commit .env.
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# The only origin the scraper may touch.
STORE_BASE_URL=https://demo.inelabteamdev.com

# Supabase (server-only; never expose to the frontend). Required in production.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secrets: long random strings (generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))").
CRON_SECRET=
ADMIN_TOKEN=

# Comma-separated allowed origins for the frontend.
CORS_ORIGIN=http://localhost:5173

# Scraper tuning (defaults shown).
HEADLESS=true
SCRAPE_MAX_TRIES=4
SCRAPE_TRY_TIMEOUT_MS=90000
SCRAPE_RUN_BUDGET_MS=900000
MAX_TRACKED_ITEMS=12
